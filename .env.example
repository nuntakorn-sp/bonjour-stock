# === เซิร์ฟเวอร์ (server.ts) ===

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL (optional): โมเดลที่จะใช้ ค่าเริ่มต้นคือ gemini-2.5-flash
# ดูชื่อรุ่นที่ใช้ได้จาก https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL="gemini-2.5-flash"

# AI_TIMEOUT_MS (optional): timeout เรียก Gemini เป็นมิลลิวินาที (ค่าเริ่มต้น 45000)
# AI_TIMEOUT_MS="45000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# === ฝั่งเบราว์เซอร์ (Vite — ต้องขึ้นต้นด้วย VITE_) ===

# Supabase: ใส่ URL + anon key ของโปรเจคตัวเอง
# หาได้ที่ Project Settings → API ใน Supabase Dashboard
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# อีเมลของผู้ดูแลระบบ (ต้องมีบัญชีจริงใน Supabase Auth)
# ปุ่ม "ผู้ดูแล" ในหน้า Login จะกรอกอีเมลนี้ให้อัตโนมัติ (ยังต้องกรอกรหัสผ่านเอง)
VITE_ADMIN_EMAIL="admin@example.com"
